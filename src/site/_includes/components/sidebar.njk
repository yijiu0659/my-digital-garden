<aside>
      <div class="sidebar">
            <div class="sidebar-container">
                  {% set slotName = "sidebar.top" %}{% include "components/pluginSlot.njk" %}
                  {% for imp in dynamics.sidebar.top %}
                        {% include imp %}
                  {% endfor %}
                  {%if settings.dgShowLocalGraph === true%}
                        {%include "components/graphScript.njk"%}
                  {%endif%}

                {% if settings.dgShowToc === true %}
<div class="toc" id="page-toc">
    <div class="toc-title-container">
        <div class="toc-title">目录</div>
    </div>
    <div class="toc-container" id="toc-container"></div>
</div>

<script>
(function () {
    function createTOC() {
        const content = document.querySelector('.content');
        const toc = document.getElementById('toc-container');

        if (!content || !toc) return;

        const headings = content.querySelectorAll('h1, h2, h3, h4, h5, h6');

        if (!headings.length) {
            document.getElementById('page-toc').style.display = 'none';
            return;
        }

        const nav = document.createElement('nav');
        const list = document.createElement('ol');

        headings.forEach((heading, index) => {
            // 跳过文章标题
            if (heading.parentElement.tagName === 'HEADER') return;

            if (!heading.id) {
                heading.id = 'heading-' + index;
            }

            const li = document.createElement('li');
            const a = document.createElement('a');

            a.href = '#' + heading.id;
            a.textContent = heading.textContent.trim();

            li.appendChild(a);
            list.appendChild(li);
        });

        nav.appendChild(list);
        toc.appendChild(nav);

        // 当前阅读位置高亮
        const links = toc.querySelectorAll('a');

        function updateActive() {
            let current = null;

            headings.forEach(function (heading) {
                if (heading.parentElement.tagName === 'HEADER') return;

                if (heading.getBoundingClientRect().top <= 120) {
                    current = heading;
                }
            });

            links.forEach(function (link) {
                link.classList.remove('toc-active');
            });

            if (current) {
                const activeLink = toc.querySelector(
                    'a[href="#' + CSS.escape(current.id) + '"]'
                );

                if (activeLink) {
                    activeLink.classList.add('toc-active');
                }
            }
        }

        window.addEventListener('scroll', updateActive, { passive: true });
        updateActive();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', createTOC);
    } else {
        createTOC();
    }
})();
</script>
{% endif %}

                  {%endif%}

                        {%if settings.dgShowBacklinks === true %}
                              {%if settings.dgShowBacklinks === true %}
                              <div class="backlinks">
                                    <div class="backlink-title">{{ meta.uiStrings.backlinkHeader }}</div>
                                          <div class="backlink-list">
                                          {%- set currentNode = graph.nodes[page.url] or graph.nodes[graph.homeAlias] -%}
                                          {%- if currentNode -%}
                                                {%- if currentNode.backLinks.length === 0 -%}
                                                      <div class="backlink-card">
                                                            <span class="no-backlinks-message">{{ meta.uiStrings.noBacklinksMessage }}</span>
                                                      </div>
                                                {%- endif -%}
                                                {%- for backlink in currentNode.backLinks -%}
                                                      {%- if graph.nodes[backlink].url != page.url and not graph.nodes[backlink].private -%}
                                                      <div class="backlink-card">
                                                            {%- if not meta.noteIconsSettings.backlinks -%}<i  data-lucide="link"></i> {%- endif -%}<a href="{{graph.nodes[backlink].url}}" data-note-icon="{{graph.nodes[backlink].noteIcon}}" class="backlink">{{graph.nodes[backlink].title}}</a>
                                                      </div>
                                                      {%- endif -%}
                                                {%- endfor -%}
                                          {%- endif -%}
                                    </div>
                              </div>
                        {%endif%}
                  {%endif%}
                  {% set slotName = "sidebar.bottom" %}{% include "components/pluginSlot.njk" %}
                  {% for imp in dynamics.sidebar.bottom %}
                        {% include imp %}
                  {% endfor %}
            </div>
      </div>
</aside>
