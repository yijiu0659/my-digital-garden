THEME=https://raw.githubusercontent.com/xainapse/Allium/HEAD/theme.css
BASE_THEME=light
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
SITE_NAME_HEADER=逸久の花园
STYLE_SETTINGS_CSS=body.css-settings-manager { --anim-motion-baseline: cubic-bezier(0.1, 0, 0.1, 1.25); --tab-text-align: left; --tab-stacked-spine-order: row; --file-header-justify: center; --hover-sidedock-trigger-area: 1px; --nav-indentation-guide-color: rgba(var(--mono-rgb-100), 0.12); --inline-title-align: start; --h1-variant: normal; --h1-style: italic; --h1-transform: normal; --h1-align: center; --hr-align: start; --bases-toolbar-label-display: none; --bases-table-header-icon-display: flex; --bases-table-align-items: start; --blockquote-font-style: normal; --indentation-guide-color: rgba(var(--mono-rgb-100), 0.12); --tag-radius: 16px; --h2-align: start; --density-modifier: 0.75; --radius-modifier: 1.5; --header-height: 40px; } body.theme-light.css-settings-manager { --bold-color: #A44F3E; --italic-color: #BC7F41; --background-primary: #FAF7F1; --background-primary-alt: #FAF7F1; --h1-color: #1D345C; --h2-color: #52377A; --h3-color: #0E6E63; --h4-color: #CE5567; --h5-color: #9C6B1E; } body.theme-dark.css-settings-manager { --bold-color: #DC9696; --italic-color: #DAB287; }
STYLE_SETTINGS_BODY_CLASSES=mod-windows is-frameless is-hidden-frameless is-maximized obsidian-app styled-scrollbars theme-light show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager hide-baseline-info color-scheme-accent melange-light contrast-light-tonal melange-dark contrast-dark-tonal layout-macos input-cupertino status-bar-baseline dynamic-type-off tab-underline-accented tab-divider tab-stack-top view-header-title-hover tab-top-left-icon tab-left-icon tab-top-right-icon tab-right-icon nav-action-dot hide-vault-switcher-off hover-sidedock nav-item-subtle colorful-folders-side bold-folders active-line-off active-line-color-default table-normal bases-normal img-normal metadata-default metadata-add-property-always metadata-list-tags metadata-longtext colorful-headings-off colorful-headings-background blockquote-baseline callouts-outlined code-default embed-side embed-hide-title media-width-full img-grid pdf-shadow table-width-full mdrazor-fold-active-line
SITE_MAIN_LANGUAGE=zh-CN